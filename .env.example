# Copy this file to .env.local and fill in what you need.
# Nothing here is required: without an AI provider the advisor runs in demo mode
# (rule-based matching on budget, brand and "good for" tags).

# Which engine answers "Help me choose":
#   demo              -> no AI, no key needed (default)
#   anthropic         -> Claude, via the official Anthropic SDK
#   openai-compatible -> any OpenAI-compatible Chat Completions API
#                        (OpenAI, Mistral, Groq, OpenRouter, a local Ollama, ...)
AI_PROVIDER=demo

# Secret key for the chosen provider. Read on the server only, never sent to the browser.
# For anthropic you can use ANTHROPIC_API_KEY instead of AI_API_KEY.
AI_API_KEY=

# Model name. Defaults to claude-opus-5 for anthropic. Required for openai-compatible.
AI_MODEL=

# openai-compatible only: base URL of the API (default https://api.openai.com/v1).
AI_BASE_URL=

# anthropic only: server-side fallback when the model declines a request
# ("default" = Anthropic's recommended fallback model; "off" to disable).
AI_FALLBACKS=default

# Seconds before the advisor gives up on the AI and answers in demo mode instead.
AI_TIMEOUT_SECONDS=30

# Public address of the site, used for absolute links in page metadata (hreflang, sharing).
SITE_URL=http://localhost:3000
