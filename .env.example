# Copy this file to .env.local and fill in what you need.
# Nothing here is required: without an AI provider the advisor runs in demo mode
# (rule-based matching on budget, brand and "good for" tags).

# Which engine answers "Help me choose" AND the support chat (bubble, bottom right):
#   demo              -> no AI, no key needed (default). The advisor uses simple rules;
#                        the support chat only gives the shop's contact details.
#   anthropic         -> Claude, via the official Anthropic SDK
#   openai-compatible -> any OpenAI-compatible Chat Completions API
#                        (Groq, Google Gemini, OpenAI, Mistral, OpenRouter, a local Ollama, ...)
#
# Free tier, Groq (key: https://console.groq.com/keys):
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile
#   AI_API_KEY=gsk_...
#
# Free tier, Google Gemini (key: https://aistudio.google.com/apikey):
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   AI_MODEL=gemini-2.5-flash
#   AI_API_KEY=AIza...
AI_PROVIDER=demo

# >>> PUT YOUR SECRET API KEY HERE (in .env.local, never in the code) <<<
# Read on the server only, never sent to the browser.
# For anthropic you can use ANTHROPIC_API_KEY instead of AI_API_KEY.
AI_API_KEY=

# Model name. Defaults to claude-opus-5 for anthropic. Required for openai-compatible.
AI_MODEL=

# openai-compatible only: base URL of the API (default https://api.openai.com/v1).
AI_BASE_URL=

# anthropic only: server-side fallback when the model declines a request
# ("default" = Anthropic's recommended fallback model; "off" to disable).
AI_FALLBACKS=default

# Seconds before the advisor gives up on the AI and answers in demo mode instead.
AI_TIMEOUT_SECONDS=30

# Public address of the site, used for absolute links in page metadata (hreflang, sharing).
SITE_URL=http://localhost:3000

# --- Admin back office (/admin) ---------------------------------------------
# TEMPORARY login, not production-grade: one shared email/password.
# In development, if unset, the admin uses admin@novacell.test / novacell-dev.
# In production, the admin stays locked until both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: key that signs admin sessions (defaults to one derived from the credentials).
ADMIN_SESSION_SECRET=

# Optional: folder holding the JSON "database" (default: ./data).
NOVACELL_DATA_DIR=

# --- Online payment (checkout) ----------------------------------------------------
# Which payment provider new orders use:
#   demo   -> pretend payments, no card (the default outside production)
#   stripe -> Stripe Checkout (needs STRIPE_SECRET_KEY)
# In production, online payment stays off until this is set.
PAYMENT_PROVIDER=
# Stripe secret key (sk_test_... while testing). Server only, never NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
# Signing secret of the webhook pointing at <SITE_URL>/api/payments/stripe, with the events
# checkout.session.completed, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed and checkout.session.expired.
# Locally: `stripe listen --forward-to localhost:3000/api/payments/stripe` prints one.
STRIPE_WEBHOOK_SECRET=

# --- Supabase ------------------------------------------------------------------
# Read on the server only by @supabase/server (src/lib/supabase/server.ts).
# Nothing in the browser uses Supabase yet, so there are no NEXT_PUBLIC_ variables.
SUPABASE_URL=
# Secret key: bypasses Row Level Security. Server only, never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# For future client-scoped (RLS) access and signed-in users.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=
